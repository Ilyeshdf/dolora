# ==============================================================================
# Dolora (ALGOS-Δ) Clinical Dashboard Environment Template
# Duplicate this file as '.env' and fill in your actual private credentials.
# Note: '.env' is git-ignored to prevent accidental exposure of keys/links.
# ==============================================================================

# Backend API & WebSocket Services
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# AI / Pain Prediction Model Integration
# Configure your private AI service / inference endpoint and API key:
VITE_AI_SERVICE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL_VERSION=v1.0

# Dashboard Configuration
VITE_DEFAULT_BED_ID=4
VITE_DEFAULT_LOCALE=en

